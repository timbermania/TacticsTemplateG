#!/usr/bin/env python

# Two GDExtension libraries, split along D1 (#374)'s SPU/FFT seam.
#
#   addons/exmateria_spu/bin/libexmateria_spu…   the published generic PSX SPU
#   addons/exmateria_sound/bin/libfftsmd…        the monorepo-only SMD core
#
# The second one is NOT part of any install: exmateria-sound.manifest excludes
# its .gdextension, so a published tree has no FFTSmdSequencerNative and
# sequencer.gd falls back to its GDScript driver by name (D2 #375 dec. 2).
# It still has to carry the SPU sources — FFTSmdSequencerNative embeds
# fftshared::FFTSpuCoreRuntime by value, and a plain struct has no ClassDB
# identity to share across a GDExtension boundary.
#
# The old single-library Glob("src/native/*.cpp") is gone on purpose: a glob
# cannot express a seam, and would silently pull anything new into BOTH sides.

env = SConscript("extern/godot-cpp/SConstruct")

# src/vendor (not src/vendor/supportpsx) is what goes on the path: the
# vendored adpcm.cc includes its header as "supportpsx/adpcm.h", and the
# copy stays byte-identical to upstream. See src/vendor/README.md.
env.Append(CPPPATH=["src/native", "src/shared", "src/vendor"])

# --- the seam, as file lists ------------------------------------------------
# D1 dec. 5's assignment. Keep these two lists disjoint; a file in both means
# the seam moved and the decision record has to move with it.

SPU_SHARED = [
    "src/shared/fft_adsr_envelope.cpp",
    "src/shared/fft_spu_core_runtime.cpp",
    "src/shared/fft_spu_core_state_tools.cpp",
    "src/shared/fft_spu_lfo_tools.cpp",
    "src/shared/fft_spu_mix_tools.cpp",
    "src/shared/fft_spu_pitch_runtime.cpp",
    "src/shared/fft_spu_replay_mix_tools.cpp",
    "src/shared/fft_spu_reverb.cpp",
    "src/shared/fft_spu_sample_runtime.cpp",
    "src/shared/fft_spu_voice_runtime.cpp",
    "src/shared/fft_spu_voice_tools.cpp",
]

FFT_SHARED = [
    "src/shared/fft_pitch_tools.cpp",
    "src/shared/fft_smd_sequencer_core.cpp",
    "src/shared/fft_smd_sequencer_tools.cpp",
]

# Third-party, verbatim, MIT. SPU-side only — the SMD accelerator has no
# encoder to bind. addons/exmateria_spu/NOTICE carries the attribution the
# licence asks for, because that is the only file a stranger who installs
# the addon ever sees.
SPU_VENDOR = [
    "src/vendor/supportpsx/adpcm.cc",
]

SPU_NATIVE = [
    "src/native/exmateria_psx_spu.cpp",
    "src/native/exmateria_spu_adpcm.cpp",
    "src/native/exmateria_spu_stream.cpp",
    "src/native/exmateria_spu_register_types.cpp",
]

FFT_NATIVE = [
    "src/native/fft_smd_sequencer_native.cpp",
    "src/native/fft_smd_register_types.cpp",
]

# The SPU/FFT seam is a claim about ASSIGNMENT: no source file belongs to both
# sides. This compared SPU_SHARED against FFT_SHARED only — two of the five
# lists — so a file added to both SPU_NATIVE and FFT_NATIVE went unnoticed, and
# those two are the likeliest pair to collide (both are thin register/binding
# layers over the same core). SPU_SHARED appearing in the FFT TARGET below is
# deliberate and is not an assignment overlap.
_SPU_SIDE = [("SPU_SHARED", SPU_SHARED), ("SPU_NATIVE", SPU_NATIVE), ("SPU_VENDOR", SPU_VENDOR)]
_FFT_SIDE = [("FFT_SHARED", FFT_SHARED), ("FFT_NATIVE", FFT_NATIVE)]
for _sname, _slist in _SPU_SIDE:
    for _fname, _flist in _FFT_SIDE:
        _overlap = set(_slist) & set(_flist)
        if _overlap:
            raise Exception("SPU/FFT seam violated — %s and %s both claim: %s"
                            % (_sname, _fname, sorted(_overlap)))

# A source listed twice on the SAME side is compiled twice into one target and
# fails at link with duplicate symbols — obscure there, obvious here.
for _name, _lst in _SPU_SIDE + _FFT_SIDE:
    _dupes = sorted({_s for _s in _lst if _lst.count(_s) > 1})
    if _dupes:
        raise Exception("%s lists a source more than once: %s" % (_name, _dupes))

# src/shared uses C++20 designated initializers. GCC/MinGW accept them as an
# extension under C++17, but MSVC requires the standard be set explicitly.
if env["platform"] == "windows" and not env["use_mingw"]:
    env.Append(CXXFLAGS=["/std:c++20"])
else:
    env.Append(CXXFLAGS=["-std=c++20"])

if env["platform"] == "windows" and env["use_mingw"]:
    env.Append(LINKFLAGS=["-static-libgcc", "-static-libstdc++"])

suffix = "{}{}".format(env["suffix"], env["SHLIBSUFFIX"])

# godot-cpp builds with exceptions OFF, and the vendored encoder throws
# std::invalid_argument on a bad channel count — so it will not compile under
# the default flags. Re-enabling exceptions for that ONE translation unit is
# the price of keeping the copy verbatim; editing the throw out would fork it,
# and a fork is what src/vendor/README.md exists to forbid. Nothing in this
# repo passes a channel count at all (encode_pcm16 is mono), so the throw is
# unreachable from our call sites and never crosses back into godot-cpp's
# no-exceptions code.
#
# The two toolchains turn exceptions off DIFFERENTLY, so undoing it differs
# too (godot-cpp tools/common_compiler_flags.py:41-45):
#   GCC/clang/MinGW  -fno-exceptions        -> append -fexceptions, last wins
#   MSVC             _HAS_EXCEPTIONS=0      -> a /EH flag alone does NOT undo
#                                              this; it is a PREPROCESSOR
#                                              switch that reconfigures the
#                                              MSVC standard library, so the
#                                              define has to come back out.
vendor_env = env.Clone()
if env["platform"] == "windows" and not env["use_mingw"]:
    vendor_env["CPPDEFINES"] = [
        d for d in vendor_env.get("CPPDEFINES", [])
        if not (isinstance(d, (tuple, list)) and d[0] == "_HAS_EXCEPTIONS")
        and d != "_HAS_EXCEPTIONS"
    ]
    vendor_env.Append(CXXFLAGS=["/EHsc"])
else:
    vendor_env.Append(CXXFLAGS=["-fexceptions"])
SPU_VENDOR_OBJECTS = [vendor_env.SharedObject(src) for src in SPU_VENDOR]

spu_library = env.SharedLibrary(
    "addons/exmateria_spu/bin/libexmateria_spu{}".format(suffix),
    source=SPU_NATIVE + SPU_SHARED + SPU_VENDOR_OBJECTS,
)

smd_library = env.SharedLibrary(
    "addons/exmateria_sound/bin/libfftsmd{}".format(suffix),
    source=FFT_NATIVE + FFT_SHARED + SPU_SHARED,
)

env.NoCache(spu_library)
env.NoCache(smd_library)
Default(spu_library, smd_library)
