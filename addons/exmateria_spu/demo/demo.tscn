theme_override_font_sizes/font_size = 34
text = "ExMateria SPU"

[node name="Subtitle" type="RichTextLabel" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
bbcode_enabled = true
text = "[color=#8d98b3]A PlayStation sound chip, playing a piece it synthesised into its own RAM at boot. There is no audio file anywhere in this addon — the bass, pad and lead are harmonic stacks encoded to PSX ADPCM in about ten milliseconds, the kick is a sine whose pitch falls, and the hats and snare are the chip's own noise generator. The pad, the lead and the snare are wet through the reverb tank.[/color]"
fit_content = true
scroll_active = false

[node name="Rule" type="HSeparator" parent="Margin/Column"]
layout_mode = 2

